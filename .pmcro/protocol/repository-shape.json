    "docs",
    "eng",
    "plugins",
    "tests",
    "AGENTS.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    ".gitattributes",
    ".gitignore",
    ".markdownlint-cli2.jsonc"
  ],
  "pmcroAdditions": [".pmcro", ".grok"],
  "githubSurfaces": [
    "agents",
    "aw",
    "graders",
    "instructions",
    "plugin",
    "prompts",
    "scripts",
    "skills",
    "workflows",
    "CODEOWNERS",
